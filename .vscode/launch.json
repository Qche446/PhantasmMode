{
  "version": "0.2.0",
  "configurations": [
    
    {
      // ⭐ 推荐：先手动启动 tModLoader，等模组加载完，再 F5 附加
      "name": "🔗 附加到 tModLoader（推荐）",
      "type": "coreclr",
      "request": "attach",
      // 弹出进程列表，选择运行 tModLoader 的那个 dotnet 进程即可
      "processId": "${command:pickProcess}",
      "justMyCode": true,
      "enableStepFiltering": true,
      "sourceLink": true,
      "requireExactSource": false,
      "logging": {
        "moduleLoad": false
      }
    },
    {
      "name": "🐛 调试启动（轻量模组时可用）",
      "type": "coreclr",
      "request": "launch",
      "program": "E:/SteamLibrary/steamapps/common/tModLoader/dotnet/dotnet.exe",
      "args": ["tModLoader.dll"],
      "cwd": "E:/SteamLibrary/steamapps/common/tModLoader",
      "preLaunchTask": "build",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "enableStepFiltering": true,
      "sourceLink": true,
      "requireExactSource": false,
      "logging": {
        "moduleLoad": false
      }
    },
    {
      "name": "🐛 含 tModLoader 源码",
      "type": "coreclr",
      "request": "launch",
      "program": "E:/SteamLibrary/steamapps/common/tModLoader/dotnet/dotnet.exe",
      "args": ["tModLoader.dll"],
      "cwd": "E:/SteamLibrary/steamapps/common/tModLoader",
      "preLaunchTask": "build",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": false,
      "enableStepFiltering": true,
      "sourceLink": true,
      "requireExactSource": false,
      "logging": {
        "moduleLoad": false
      }
    },
    {
      "name": "⚡ 快速启动（跳过构建）",
      "type": "coreclr",
      "request": "launch",
      "program": "E:/SteamLibrary/steamapps/common/tModLoader/dotnet/dotnet.exe",
      "args": ["tModLoader.dll"],
      "cwd": "E:/SteamLibrary/steamapps/common/tModLoader",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "enableStepFiltering": true,
      "sourceLink": true,
      "requireExactSource": false,
      "logging": {
        "moduleLoad": false
      }
    }
  ]
}
