# This file will automatically update with entries for new content after a build and reload.

Items: {
	BrokenTimepiece: {
		DisplayName: 破缺的时计
		Tooltip:
			'''
			免疫缓慢
			“表壳上覆着薄薄的灰，异色的表盘泛着温润的光，像刚从梦里醒来。玻璃面早已碎了，时针和分针各自歪着，停在不知哪一年的某个时刻。”
			“停留在过去之物，为此刻的你，许诺一个被祝福的明天。”
			'''
	}
}

