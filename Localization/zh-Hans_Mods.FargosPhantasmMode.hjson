Enchantments: {
	TungstenEnchant: 境妄 : 近战武器大小增幅调整为75%，强化时效果翻倍
	NinjaEnchant: 境妄 : 添加额外能力:大幅提升攻速且增加盔甲穿透，但是伤害降低。强化时该效果增强
}

Masomode: {
	AgitatingLens:
		'''
		境妄 : 移动速度增加10%，生命值降低至一半以下时效果提升至30%。
		血镰刀能对敌人造成月之诅咒和狂暴减益
		'''
	SlimyShield:
		'''
		境妄 : 平台直穿效果在背包中即可生效
		粘液球能对敌人造成宇宙之焰减益
		'''
	DarkenedHeart: 境妄 : 迷你噬魂者现在将额外造成固定0.1%的百分比伤害
	GuttedHeart:
		'''
		境妄 : 周期性生成伤害性震荡，对大部分敌怪附加[c/FF0000:碎心]
		[c/FF0000:碎心] : 最大生命值减少15%
		'''
	QueenStinger: 境妄 : 给予蜂蜜增益效果，背包中即可生效
	NecromanticBrew:
		'''
		境妄 : 骷髅手臂能对敌人造成暗影焰减益
		冲刺加速效果可以进一步提升至50%
		'''
	Deerclawps: 境妄 : 冰刺生成条件优化且伤害更高，体积更大，能对敌人造成霜冻减益

	SupremeDeathbringerFairy: {
		Base:
			'''
			境妄 : 继承下位额外效果
			[i:FargowiltasSouls/SlimyShield]平台直穿效果背包中即可生效
			[i:FargowiltasSouls/SlimyShield]粘液球造成宇宙之焰减益
			[i:FargowiltasSouls/AgitatingLens]根据当前生命值增加移速
			[i:FargowiltasSouls/AgitatingLens]鲜血镰刀造成[c/00FFFF:月之诅咒]和[c/FF0000:狂暴]减益
			[i:FargowiltasSouls/QueenStinger]给予[c/CCCC00:蜂蜜]增益，背包中即可生效
			[i:FargowiltasSouls/NecromanticBrew]给予额外冲刺加速效果
			[i:FargowiltasSouls/NecromanticBrew]骷髅王手臂造成[c/6600CC:暗影焰]减益
			'''
		Extra: “四弦同颤，余烬复燃...”
	}

	PungentEyeball: 境妄 : [c/FF0000:尖刻注视]累积速度提升
	GelicWings: 境妄 : 凝胶尖刺能对敌人造成宇宙之焰和浸油减益
	ReinforcedPlating:
		'''
		境妄 : 对伤害你的敌人造成[c/FF0000:纳米侵蚀]
		[c/FF0000:纳米侵蚀]:受到的减益伤害乘1.2，破晓减益伤害被增幅的效果不再减半，魔法诅咒的减益伤害增幅改为乘算
		'''
	FusedLens:
		'''
		境妄 : 生成友好的双色机械电球围绕着你，周围有敌人时自动追击
		受到灵液或咒焰时生成暗星，额外造成浸油减益
		'''
	GroundStick: 境妄 : 对激光类弹幕的减伤提升至80%

	DubiousCircuitry: {
		Base:
			'''
			境妄 : 继承下位额外效果
			[i:FargowiltasSouls/ReinforcedPlating]对伤害你的敌人造成[c/FF0000:纳米侵蚀]
			[c/FF0000:纳米侵蚀]:受到的减益伤害乘1.2，破晓减益伤害被增幅的效果不再减半，魔法诅咒的减益伤害增幅改为乘算
			[i:FargowiltasSouls/FusedLens]生成友好的四色电球围绕着你，周围有敌人时自动追击，受到灵液或咒焰时生成暗星
			[i:FargowiltasSouls/GroundStick]对激光类弹幕的减伤提升至80%
			'''
		Extra: “总之，是很硬的东西!”
	}

	PureHeart: {
		Base:
			'''
			境妄 : [i:FargowiltasSouls/PureHeart]15s内不受到伤害则给予[c/00FFAB:无暇]增益
			[c/00FFAB:无暇] [b/FargosPhantasmMode/FlawlessBuff]: 提升生命再生速度，增加10点盔甲穿透，10%暴击率，10点防御和10%的减伤
			继承下位额外效果
			[i:FargowiltasSouls/DarkenedHeart]迷你噬魂者造成0.1%百分比伤害
			[i:FargowiltasSouls/GuttedHeart]更高的频率生成范围更大的碎心震荡
			[i:FargowiltasSouls/GelicWings]凝胶尖刺造成宇宙之焰和浸油减益
			'''
		Extra: “净魂绝垢，羽化登仙”
	}

