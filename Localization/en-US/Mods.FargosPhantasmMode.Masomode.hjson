AgitatingLens:
	'''
	Increases movement speed by 10%, raised to 30% below half maximum life
	Blood Scythes inflict Moon Curse and Berserk
	'''
SlimyShield:
	'''
	Platforms can be passed through while this item is in the inventory
	Slime Balls inflict the Cosmo Flame debuff
	'''
DarkenedHeart: Mini Eaters deal an additional 0.1% of the enemy's maximum life as damage
GuttedHeart:
	'''
	Periodically creates a Gutted Heart shockwave that inflicts [c/FF0000:Heartbroken]
	[c/FF0000:Heartbroken] reduces maximum life by 15%
	'''
QueenStinger:
	'''
	Grants the Honey buff; works from the inventory
	Bee dashes enter precision mode. If you take no damage during the dash, its cooldown is halved afterward
	'''
NecromanticBrew:
	'''
	Skeletron's arms inflict Shadowflame
	Dash speed can be further increased to 50%
	'''
Deerclawps: Eases the conditions for Ice Spikes to spawn and further increases their damage

SupremeDeathbringerFairy: {
	Base:
		'''
		Inherits additional effects from lower tiers
		[i:FargowiltasSouls/SlimyShield]Platforms can be passed through while this item is in the inventory
		[i:FargowiltasSouls/SlimyShield]Slime Balls inflict the Cosmo Flame debuff
		[i:FargowiltasSouls/AgitatingLens]Increases movement speed by 10%, raised to 30% below half maximum life
		[i:FargowiltasSouls/AgitatingLens]Blood Scythes inflict [c/0BFFE8:Moon Curse] and [c/FF0000:Berserk]
		[i:FargowiltasSouls/QueenStinger]Grants the [c/CCCC00:Honey] buff; works from the inventory
		[i:FargowiltasSouls/QueenStinger]Bee dashes enter precision mode; taking no damage during the dash halves its cooldown afterward
		[i:FargowiltasSouls/NecromanticBrew]Skeletron's arms inflict Shadowflame
		[i:FargowiltasSouls/NecromanticBrew]Dash speed can be further increased to 50%
		'''
	Extra: "An eternal beginning, ringing death for evil"
}

PungentEyeball: "[c/FF0000:Scathing Gaze] builds faster"
GelicWings: Gel Spikes inflict Cosmo Flame and Oiled
ReinforcedPlating:
	'''
	Inflicts [c/FF0000:Nano-Erosion] on enemies that damage you
	[c/FF0000:Nano-Erosion] multiplies debuff damage taken by 1.2. Daybreak's debuff damage bonus is no longer halved, and Magical Curse's bonus becomes multiplicative
	'''
FusedLens:
	'''
	Creates friendly dual-color Mech Electric Orbs around you that automatically pursue nearby enemies
	When affected by Ichor or Cursed Inferno, Dark Stars spawn instead and additionally inflict Oiled
	'''
GroundStick: Damage reduction against laser projectiles increased to 80%

