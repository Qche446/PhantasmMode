	DisplayName: 时神把戏
	Description: “驾虚御实，彼者怀有时光...”
}

HypothermiaBuff: {
	DisplayName: 失温症
	Description:
		'''
		急剧流失生命值，收到的伤害提升至1.05倍,破晓减益伤害被增幅的效果不再减半，魔法诅咒的减益伤害增幅改为乘算
		“失衡...”
		'''
}

PhSublimationBuff: {
	DisplayName: 影灼之升华
