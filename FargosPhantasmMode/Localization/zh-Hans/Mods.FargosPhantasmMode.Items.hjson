BrokenTimepiece: {
	DisplayName: 永恒的时计
	Tooltip:
		'''
		免疫缓慢
		“世界之礼的具现，为你献上未来的祝福”
		'''
}

ShadowveilHeart: {
	DisplayName: 影翳浊心
	Tooltip:
		'''
		[c/A0A0A0:能计算并显示你的擦弹次数]
		免疫盔甲破损
		提供擦弹能力，擦弹会持续积攒能量，这些能量会使你受到的伤害额外降低，最高25%
		在时装栏时也可启用擦弹效果，但不会提供减伤
		“深暗的力量孕育其中...”
		'''
}

EridanusGuide: {
	DisplayName: 波江指引器
	Tooltip:
		'''
		若开启波江套的效果，则在每一次切换形态时自动检测你快捷栏里的武器
		若找到对应伤害类型的武器，则自动切换到该武器
		背包中即可生效
		'''
}

Germ: {
	DisplayName: “萌芽”
	Tooltip:
		'''
		[c/A0A0A0:可以显示你最后伤害的一个敌人受到的减益秒伤]
		受到的减益伤害提升50%，且减益对你造成的伤害会致死
		将你的通用职业伤害增幅用于提高敌怪受到的减益伤害，减益可造成暴击，且生命流逝速度将受一半攻速影响
		“恶咒或新生”
		'''
}

WhiteRibbon: {
	DisplayName: 白色缎带
	Tooltip:
		'''
		纯洁无垢的缎带，拥有某种排斥“死灵”的力量
		[c/A0A0A0:玩家不再能'旋转'(死灵密酿的旋转冲刺不再会使玩家旋转，但冲刺加速的效果仍然存在)]
		'''
}
